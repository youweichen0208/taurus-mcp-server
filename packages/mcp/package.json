{
  "name": "taurusdb-mcp",
  "version": "0.5.0-rc.11",
  "description": "TaurusDB MCP server for Claude, Cursor, VS Code, and other MCP clients.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/youweichen0208/taurus-mcp-server.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/youweichen0208/taurus-mcp-server#readme",
  "bugs": {
    "url": "https://github.com/youweichen0208/taurus-mcp-server/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "taurusdb",
    "mcp",
    "model-context-protocol",
    "mysql",
    "claude"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bin": {
    "taurusdb-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "scripts"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "taurusdb-core": "0.5.0-rc.10",
    "@modelcontextprotocol/sdk": "^1.17.0",
    "mysql2": "^3.22.1",
    "zod": "^3.24.1"
  }
}
