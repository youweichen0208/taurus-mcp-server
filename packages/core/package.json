{
  "name": "taurusdb-core",
  "version": "0.5.0-rc.1",
  "description": "Shared TaurusDB data-plane engine for schema, SQL execution, guardrails, and diagnostics.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/youweichen0208/taurus-mcp-server.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/youweichen0208/taurus-mcp-server#readme",
  "bugs": {
    "url": "https://github.com/youweichen0208/taurus-mcp-server/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "taurusdb",
    "mysql",
    "database",
    "diagnostics",
    "guardrails"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "mysql2": "^3.22.1",
    "node-sql-parser": "^5.4.0",
    "pino": "^9.11.0",
    "ulid": "^3.0.1",
    "zod": "^3.24.1"
  }
}
